'use client'

// Gate Guard ONE-TIME install calculator — the dealer profit check.
// Guideline charge (working gate $500 / broken gate $750 / first camera free,
// extras $100), versus the real parts + labor cost from the cost sheet, so the
// dealer instantly sees green (makes money) or red (loses money) on a job.
// Client-side by design: the dealer must see his own cost to price the install.
import { useMemo, useState } from 'react'

const usd = (n: number) => (Number(n) || 0).toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 })
const inputStyle = { background: 'rgba(0,0,0,0.28)', border: '1px solid rgba(255,255,255,0.1)', color: 'rgba(255,255,255,0.92)' } as const

// [name, part cost, install hours] — straight from the cost sheet.
const NETWORK_PARTS: Array<[string, number, number]> = [
  ['Router', 130, 1], ['4-Port Switch', 100, 0.5], ['8-Port Switch', 200, 1], ['24-Port Switch', 800, 2.5],
  ['PoE+ Inserter', 15, 0.25], ['PoE++ Inserter', 30, 0.25], ['PoE+++ Inserter', 50, 0.25], ['24v Inserter', 15, 0.25],
  ['NSM5 Bridge', 90, 1], ['Wave AP', 550, 1.5], ['Cellular Radio', 200, 1], ['WiFi Radio', 180, 1],
]
const GATE_PARTS: Array<[string, number, number]> = [
  ['Power Relay', 30, 0.5], ['Gate Relay', 30, 0.5], ['Reflect Photobeam', 140, 1], ['Exit Photobeam', 250, 1.5],
  ['Wireless Loop', 350, 2], ['Worm Wheel', 100, 1], ['Misc', 0, 0], ['QR Sign', 100, 0.5],
  ['Callbox', 900, 2.5], ['Single Door Controller', 450, 0.5], ['Card Reader', 310, 0.5],
]

function PartTable({ title, parts, qty, setQty }: { title: string; parts: Array<[string, number, number]>; qty: Record<string, number>; setQty: (name: string, v: number) => void }) {
  return (
    <div className="rounded-2xl p-4" style={{ background: 'rgba(8,18,34,0.6)', border: '1px solid rgba(255,255,255,0.08)' }}>
      <div className="mb-2 text-[12px] font-semibold" style={{ color: 'rgba(255,255,255,0.8)' }}>{title}</div>
      <table className="w-full text-[12px]">
        <tbody>
          {parts.map(([name, cost, hours]) => (
            <tr key={name} style={{ borderTop: '0.5px solid rgba(255,255,255,0.06)' }}>
              <td className="py-1.5" style={{ color: 'rgba(255,255,255,0.75)' }}>
                {name}
                <div className="text-[9px]" style={{ color: 'rgba(255,255,255,0.35)' }}>{usd(cost)}{hours ? ` · ${hours}h` : ''}</div>
              </td>
              <td className="py-1.5 text-right">
                <input type="number" min="0" value={qty[name] ?? 0} onChange={e => setQty(name, Math.max(0, Number(e.target.value) || 0))}
                  className="w-12 rounded-md px-1.5 py-1 text-right text-[12px] outline-none" style={inputStyle} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

export function InstallCalculator({ initialWorkingGates, initialBrokenGates, initialCameras }: { initialWorkingGates?: number; initialBrokenGates?: number; initialCameras?: number } = {}) {
  const [workingGates, setWorkingGates] = useState(String(initialWorkingGates ?? ''))
  const [brokenGates, setBrokenGates] = useState(String(initialBrokenGates ?? ''))
  const [cameras, setCameras] = useState(String(initialCameras ?? ''))
  const [qty, setQtyState] = useState<Record<string, number>>({})
  const setQty = (name: string, v: number) => setQtyState(p => ({ ...p, [name]: v }))

  // Guideline fees (editable).
  const [feeWorking, setFeeWorking] = useState('500')
  const [feeBroken, setFeeBroken] = useState('750')
  const [feeExtraCam, setFeeExtraCam] = useState('100')
  const [freeCameras, setFreeCameras] = useState('1')
  const [laborRate, setLaborRate] = useState('45')

  const r = useMemo(() => {
    const n = (s: string) => Number(s) || 0
    const gW = n(workingGates), gN = n(brokenGates), cam = n(cameras)
    const extraCam = Math.max(0, cam - n(freeCameras))
    const charge = gW * n(feeWorking) + gN * n(feeBroken) + extraCam * n(feeExtraCam)
    let parts = 0, hours = 0
    for (const [name, cost, hrs] of [...NETWORK_PARTS, ...GATE_PARTS]) {
      const q = qty[name] ?? 0
      parts += q * cost; hours += q * hrs
    }
    const labor = hours * n(laborRate)
    const cost = parts + labor
    return { gW, gN, extraCam, charge, parts, hours, labor, cost, profit: charge - cost }
  }, [workingGates, brokenGates, cameras, qty, feeWorking, feeBroken, feeExtraCam, freeCameras, laborRate])

  const good = r.profit >= 0

  return (
    <div className="space-y-5">
      {/* 1. Charge (guideline) */}
      <div className="rounded-3xl p-4" style={{ background: 'linear-gradient(180deg, rgba(8,18,34,0.7), rgba(3,9,22,0.5))', border: '1px solid rgba(95,184,224,0.16)' }}>
        <div className="text-base font-semibold" style={{ color: 'rgba(255,255,255,0.95)' }}>1. What you charge</div>
        <div className="mb-3 text-[12px]" style={{ color: 'rgba(255,255,255,0.5)' }}>Working gate $500 · broken gate $750 · first camera free · extra cameras $100.</div>
        <div className="grid grid-cols-3 gap-3">
          {[['Working gates', workingGates, setWorkingGates], ['Broken gates', brokenGates, setBrokenGates], ['Cameras', cameras, setCameras]].map(([label, val, set]) => (
            <label key={label as string} className="block">
              <div className="mb-1 text-[11px] font-semibold uppercase tracking-[0.14em]" style={{ color: 'rgba(255,255,255,0.62)' }}>{label as string}</div>
              <input value={val as string} onChange={e => (set as (v: string) => void)(e.target.value.replace(/[^0-9]/g, ''))} inputMode="numeric" placeholder="0" className="w-full rounded-xl px-3 py-2.5 text-base outline-none" style={inputStyle} />
            </label>
          ))}
        </div>
      </div>

      {/* 2. Parts you'll install */}
      <div>
        <div className="mb-2 text-base font-semibold" style={{ color: 'rgba(255,255,255,0.95)' }}>2. Parts you&apos;ll install</div>
        <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <PartTable title="Network" parts={NETWORK_PARTS} qty={qty} setQty={setQty} />
          <PartTable title="Gate + access" parts={GATE_PARTS} qty={qty} setQty={setQty} />
        </div>
      </div>

      {/* 3. Result */}
      <div className="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div className="rounded-3xl p-4" style={{ background: 'rgba(8,18,34,0.6)', border: '1px solid rgba(255,255,255,0.1)' }}>
          <div className="text-[12px]" style={{ color: 'rgba(255,255,255,0.6)' }}>You charge</div>
          <div className="text-2xl font-semibold" style={{ color: 'rgba(255,255,255,0.95)' }}>{usd(r.charge)}</div>
        </div>
        <div className="rounded-3xl p-4" style={{ background: 'rgba(8,18,34,0.6)', border: '1px solid rgba(255,255,255,0.1)' }}>
          <div className="text-[12px]" style={{ color: 'rgba(255,255,255,0.6)' }}>Your cost</div>
          <div className="text-2xl font-semibold" style={{ color: 'rgba(255,255,255,0.95)' }}>{usd(r.cost)}</div>
          <div className="text-[10px]" style={{ color: 'rgba(255,255,255,0.4)' }}>parts {usd(r.parts)} + {r.hours}h labor</div>
        </div>
        <div className="rounded-3xl p-4" style={{ background: good ? 'rgba(52,211,153,0.12)' : 'rgba(248,113,113,0.12)', border: `1px solid ${good ? 'rgba(52,211,153,0.4)' : 'rgba(248,113,113,0.45)'}` }}>
          <div className="text-[12px]" style={{ color: good ? '#6ee7b7' : '#fca5a5' }}>Your profit</div>
          <div className="text-2xl font-bold" style={{ color: good ? '#6ee7b7' : '#fca5a5' }}>{usd(r.profit)}</div>
          <div className="text-[11px] font-semibold" style={{ color: good ? '#6ee7b7' : '#fca5a5' }}>{good ? 'Makes money ✓' : 'Loses money — raise charge or cut parts'}</div>
        </div>
      </div>

      <details className="text-[12px]" style={{ color: 'rgba(255,255,255,0.5)' }}>
        <summary className="cursor-pointer">Adjust fees + labor rate</summary>
        <div className="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-5">
          {[['Working $', feeWorking, setFeeWorking], ['Broken $', feeBroken, setFeeBroken], ['Extra cam $', feeExtraCam, setFeeExtraCam], ['Free cams', freeCameras, setFreeCameras], ['Labor $/hr', laborRate, setLaborRate]].map(([label, val, set]) => (
            <label key={label as string} className="block">
              <div className="mb-1 text-[10px]" style={{ color: 'rgba(255,255,255,0.5)' }}>{label as string}</div>
              <input value={val as string} onChange={e => (set as (v: string) => void)(e.target.value.replace(/[^0-9.]/g, ''))} inputMode="decimal" className="w-full rounded-lg px-2 py-1.5 text-[13px] outline-none" style={inputStyle} />
            </label>
          ))}
        </div>
      </details>
    </div>
  )
}
